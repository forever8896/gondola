# Gondola configuration. `bun run setup` copies this to .env and fills in the secrets for you.

# --- Secrets (generated by setup) -----------------------------------------------------------------
POSTGRES_PASSWORD=
DATABASE_URL=postgres://gondola:CHANGE_ME@127.0.0.1:5544/gondola
SESSION_SECRET=
# Open /admin?token=<ADMIN_TOKEN> once to see every run on this server (not just your browser's).
ADMIN_TOKEN=
# Used by the server for the curator, image descriptions and cost tracking. The agents inside the sandboxes
# get their key from your Boat AI profile instead (boat ai profile set-key default openrouter-api-key).
OPENROUTER_API_KEY=

# --- Where it runs -------------------------------------------------------------------------------
# The app and the generated pages are served from two different origins so agent-written HTML can never
# touch the app. Locally that's two ports; in production use two subdomains (e.g. gondola.example, pages.gondola.example).
APP_PORT=8787
CONTENT_PORT=8788
APP_ORIGIN=http://localhost:8787
CONTENT_ORIGIN=http://localhost:8788

# --- Which AI account pays ---------------------------------------------------------------------
# openrouter   (default) an OpenRouter key, here and in your Boat AI profile
# subscription your own Claude subscription: the agents run Claude Code in the sandboxes on the Claude sign-in in your
#              Boat AI profile, and the curator/image descriptions use your local `claude` CLI. Set the models below to
#              Claude Code names (MODEL=claude-sonnet-5-5, EXTRACT_MODEL=claude-haiku-5-5). 25 Sonnet designers ran in
#              parallel in under 5 minutes in our tests. Your Boat AI profile must hold ONLY the Claude sign-in (with an
#              OpenRouter key next to it, Boat bills OpenRouter instead). Personal use of your own account only.
AI_BACKEND=openrouter
# Model for the local CLI in subscription mode, and the agents' reasoning effort in Boat's claude harness (low|medium|high).
LOCAL_CLAUDE_MODEL=haiku
AGENT_REASONING=

# --- Models (OpenRouter ids, prefixed for Boat's harness) ---------------------------------------
# Builds the designs. Sonnet 5.5 designs clearly better than Haiku 5.5 (same directions, side by side) at about the same
# speed; Haiku is the cheaper option on OpenRouter (~$0.06 per design): MODEL=openrouter:anthropic/claude-haiku-5.5
MODEL=openrouter:anthropic/claude-sonnet-5.5
# Copies the site's content into content.md before the designs start.
EXTRACT_MODEL=openrouter:deepseek/deepseek-v4.1-flash
# Picks the 25 design directions and writes each one's art direction (called directly, no harness prefix).
CURATOR_MODEL=anthropic/claude-haiku-5.5
# Describes the site's images so agents don't crop text out of them.
VISION_MODEL=google/gemini-3.5-flash-lite

# --- Run size and Boat capacity ------------------------------------------------------------------
# Designs per run. Each design is one sandbox; a run uses DEFAULT_COUNT + 1 sandboxes.
DEFAULT_COUNT=25
MAX_COUNT=25
# Minutes each design agent may work before its page is captured as it is.
AGENT_BUDGET_MIN=12
# Keep these at or below your Boat plan (`boat limits`). Defaults fit the $20 plan: 100 active, 12/min, 60/h, 200/day.
# With Boat's "extra starts" switched on you can raise them (36/min, 360/h, 1200/day on that plan).
MAX_ACTIVE_SANDBOXES=95
STARTS_PER_MINUTE=11
STARTS_PER_HOUR=58
STARTS_PER_DAY=195

# --- Access ----------------------------------------------------------------------------------------
# Max runs per UTC day across all visitors (operators excluded). 0 = unlimited. Set this before exposing the app publicly.
DAILY_RUN_LIMIT=0
# Include the calm directions (pure type, docs, e-reader...) in the pool. Off: every run gets showpiece styles.
INCLUDE_CALM_BRIEFS=0
# Lets POST /api/runs pick another model from an allow-list. For benchmarking only.
ALLOW_MODEL_OVERRIDE=0

# How long a prepared site (bun run prewarm <domain>) is kept for instant runs.
WARM_TTL_HOURS=24

# Share pages (bun run share): where they are published, and the Cloudflare Pages project.
# SHARE_ORIGIN=https://gondola.example.com
# SHARE_PROJECT=gondola
